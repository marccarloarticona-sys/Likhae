#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$argv = $_SERVER['argv'] ?? [];
$isInternalServe = ($argv[1] ?? null) === 'serve'
    && in_array('--likhae-internal', array_slice($argv, 2), true);

if (
    ($argv[1] ?? null) === 'serve'
    && ! $isInternalServe
    && getenv('LIKHAE_ARTISAN_DEV_SUPERVISED') !== '1'
    && ! array_intersect(['--help', '-h'], array_slice($argv, 2))
) {
    $serveArguments = array_slice($argv, 2);
    $hasHostOption = false;
    $hasPortOption = false;

    foreach ($serveArguments as $argument) {
        if ($argument === '--host' || $argument === '-H' || str_starts_with($argument, '--host=')) {
            $hasHostOption = true;
        }

        if ($argument === '--port' || $argument === '-p' || str_starts_with($argument, '--port=')) {
            $hasPortOption = true;
        }
    }

    if (! $hasHostOption) {
        $serveArguments[] = '--host=0.0.0.0';
    }

    if (! $hasPortOption) {
        $serveArguments[] = '--port=8001';
    }

    $serveCommand = 'php artisan serve';

    if ($serveArguments !== []) {
        $serveCommand .= ' '.implode(' ', array_map('escapeshellarg', $serveArguments));
    }

    $supervisedServeCommand = $serveCommand.' --likhae-internal';

    \Illuminate\Foundation\DevCommands::register($supervisedServeCommand, 'server');
    \Illuminate\Foundation\DevCommands::artisan('reverb:start', 'reverb');
    $developmentServices = ['server', 'vite', 'reverb'];
    $apacheExecutable = 'C:/xampp/apache/bin/httpd.exe';
    $apacheConfig = 'deploy/apache/likhae-reverse-proxy.conf';

    if (is_file($apacheExecutable) && is_file(__DIR__.'/'.$apacheConfig)) {
        \Illuminate\Foundation\DevCommands::register(
            'php scripts/run-apache-proxy.php',
            'proxy'
        );
        $developmentServices[] = 'proxy';
    }

    \Illuminate\Foundation\DevCommands::only(...$developmentServices);
    // Laravel's dev runner supervises and restarts the application server,
    // reverse proxy, Vite, and Reverb processes automatically.
    putenv('LIKHAE_ARTISAN_DEV_SUPERVISED=1');
    $argv = array_slice($argv, 0, 2);
    $argv[1] = 'dev';
}

if ($isInternalServe) {
    $argv = array_values(array_filter($argv, fn ($argument) => $argument !== '--likhae-internal'));
}

$status = $app->handleCommand(new ArgvInput($argv));

exit($status);
